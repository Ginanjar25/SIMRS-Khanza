+ (($F{penilaian} == null || $F{penilaian}.toString().trim().isEmpty()) ? "" : "\nA : " + $F{penilaian})

+ (($F{rtl} == null || $F{rtl}.toString().trim().isEmpty()) ? "" : "\nP : " + $F{rtl})

+ (($F{instruksi} == null || $F{instruksi}.toString().trim().isEmpty()) ? "" : "\nI : " + $F{instruksi})

