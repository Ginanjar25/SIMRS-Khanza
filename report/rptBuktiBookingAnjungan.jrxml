	<parameter name="logo" class="java.io.InputStream"/>
	<parameter name="namars" class="java.lang.String"/>
	<parameter name="alamatrs" class="java.lang.String"/>
	<parameter name="kotars" class="java.lang.String"/>
	<parameter name="propinsirs" class="java.lang.String"/>
	<parameter name="kontakrs" class="java.lang.String"/>
	<parameter name="emailrs" class="java.lang.String"/>
	<parameter name="kodeAnjungan" class="java.lang.String"/>
	<parameter name="noRM" class="java.lang.String"/>
	<parameter name="tanggalPeriksa" class="java.lang.String"/>
	<parameter name="kodeDokter" class="java.lang.String"/>
	<parameter name="kodePoli" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT br.no_rkm_medis, ps.nm_pasien, pl.nm_poli, dr.nm_dokter, pj.png_jawab,
	CONCAT(ELT(DAYOFWEEK(br.tanggal_periksa),'Minggu','Senin','Selasa','Rabu','Kamis','Jumat','Sabtu'),', ',DATE_FORMAT(br.tanggal_periksa,'%d-%m-%Y')) AS tglperiksa,
	IFNULL((SELECT GROUP_CONCAT(CONCAT(TIME_FORMAT(jd.jam_mulai,'%H:%i'),' - ',TIME_FORMAT(jd.jam_selesai,'%H:%i')) ORDER BY jd.jam_mulai SEPARATOR ', ') FROM jadwal jd
		WHERE jd.kd_dokter=br.kd_dokter AND jd.kd_poli=br.kd_poli
		AND jd.hari_kerja=ELT(DAYOFWEEK(br.tanggal_periksa),'AKHAD','SENIN','SELASA','RABU','KAMIS','JUMAT','SABTU')),'-') AS jampraktek,
	CONCAT(IF(br.kd_poli='U0026','LAK',IFNULL((SELECT mpb.kd_poli_bpjs FROM maping_poli_bpjs mpb WHERE mpb.kd_poli_rs=br.kd_poli LIMIT 1),br.kd_poli)),
		'-',IF(br.kd_pj='BPJ','B','A'),LPAD(br.no_reg,GREATEST(3,CHAR_LENGTH(br.no_reg)),'0')) AS noantrean
	FROM booking_registrasi br
	JOIN pasien ps ON ps.no_rkm_medis=br.no_rkm_medis
	JOIN poliklinik pl ON pl.kd_poli=br.kd_poli
	JOIN dokter dr ON dr.kd_dokter=br.kd_dokter
	LEFT JOIN penjab pj ON pj.kd_pj=br.kd_pj
	WHERE br.no_rkm_medis=$P{noRM} AND br.tanggal_periksa=$P{tanggalPeriksa} AND br.kd_dokter=$P{kodeDokter} AND br.kd_poli=$P{kodePoli}]]>
	</queryString>
